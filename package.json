{
  "name": "conc-liq",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Robinhood Chain Uniswap v3 concentrated-liquidity observer",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "accounting:snapshot": "node --import tsx src/accounting.ts",
    "action-cost:snapshot": "node --import tsx src/action-cost.ts",
    "action-cost:assess": "node --import tsx src/action-cost-assess.ts",
    "action-cost:value": "node --import tsx src/action-cost-value.ts",
    "approval-cost:snapshot": "node --import tsx src/approval-cost.ts",
    "approval-cost:value": "node --import tsx src/approval-cost-value.ts",
    "backfill": "node --import tsx src/backfill.ts",
    "backtest:baseline": "node --import tsx src/backtest.ts",
    "build": "tsc -p tsconfig.json",
    "canary:plan": "node --import tsx src/canary-plan.ts",
    "canary:rehearse": "node --import tsx src/canary-rehearse.ts",
    "check": "npm run typecheck && npm test",
    "dashboard": "node --import tsx src/dashboard.ts",
    "history:compare": "node --import tsx src/history-compare.ts",
    "joined-policy:replay": "node --import tsx src/joined-policy-replay.ts",
    "cost-model:resolve": "node --import tsx src/cost-model-resolve.ts",
    "db:migrate": "node --import tsx src/migrate.ts",
    "nft:snapshot": "node --import tsx src/nft.ts",
    "observe": "node --import tsx src/index.ts",
    "oracle:calibrate": "node --import tsx src/oracle-calibrate.ts",
    "oracle-policy:replay": "node --import tsx src/oracle-policy-replay.ts",
    "perp-basis": "node --import tsx src/perp-basis.ts",
    "perp-reference": "node --import tsx src/perp-reference.ts",
    "principal:reconstruct": "node --import tsx src/principal.ts",
    "policy:replay": "node --import tsx src/policy-replay.ts",
    "range:simulate": "node --import tsx src/simulate.ts",
    "reconcile": "node --import tsx src/reconcile.ts",
    "replay": "node --import tsx src/replay.ts",
    "risk:gate": "node --import tsx src/risk-gate.ts",
    "risk:snapshot": "node --import tsx src/risk.ts",
    "rpc:health": "node --import tsx src/rpc-health.ts",
    "start": "node dist/src/index.js",
    "strategy:checkpoint": "node --import tsx src/strategy-checkpoint.ts",
    "tail": "node --import tsx src/tail.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "paper": "node --import tsx src/paper.ts",
    "paper:simulate": "node --import tsx src/paper-execute.ts",
    "test:integration": "node --import tsx test/integration/migrations.mjs && node --import tsx test/integration/paper-lifecycle.mjs && node --import tsx test/integration/paper-reference.mjs",
    "release:build": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "viem": "^2.38.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}

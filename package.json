{
  "name": "conc-liq",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Robinhood Chain Uniswap v3 concentrated-liquidity observer",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "db:migrate": "node --import tsx src/migrate.ts",
    "observe": "node --import tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "viem": "^2.38.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}

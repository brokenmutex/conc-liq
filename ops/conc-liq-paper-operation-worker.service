# Rendering template: use scripts/render-release-units.mjs; do not install directly.
# Set DEPLOYMENT_PAPER_OPERATION_WORKER=1 in the rendered private environment
# file. launch.mjs strips inherited Environment= values before starting worker.
[Unit]
Description=conc-liq supervised static/manual and RangeKeeper paper operation worker
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/root/conc-liq
EnvironmentFile=/root/conc-liq/.env
Environment=PATH=/root/conc-liq/.tools/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/false
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Nice=10

[Install]
WantedBy=multi-user.target

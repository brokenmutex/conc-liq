# Rendering template: use scripts/render-release-units.mjs; do not install directly.
[Unit]
Description=conc-liq live paper position observer
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/root/conc-liq
EnvironmentFile=/root/arb-robinhood/.env
EnvironmentFile=/root/conc-liq/.env
Environment=PATH=/root/conc-liq/.tools/node/bin:/root/.foundry/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash -c 'export RH_INDEXER_RPC_URL="$ROBINHOOD_READ_HTTP_URL"; exec npm run paper -- tick'
TimeoutStartSec=3min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

# Rendering template: use scripts/render-release-units.mjs; do not install directly.
[Unit]
Description=conc-liq confirmation-safe Robinhood V3 index and replay tail
After=network-online.target postgresql.service conc-liq-rpc-health.service
Wants=network-online.target
Requires=postgresql.service conc-liq-rpc-health.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/root/conc-liq
EnvironmentFile=/root/conc-liq/.env
EnvironmentFile=/root/arb-robinhood/.env
Environment=PATH=/root/conc-liq/.tools/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash -c 'export RH_INDEXER_RPC_URL="$ROBINHOOD_READ_HTTP_URL"; exec npm run tail'
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

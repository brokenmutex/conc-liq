# Private runtime env file for the supervised live wallet worker
# (conc-liq-rangekeeper.service, launch entry deployments-live-worker).
# Install as a root-owned, mode 0600 file and pass its path to launch.mjs.
# Names only: set every value on the host. Never commit values. The signing key is
# NOT stored here; DEPLOYMENT_LIVE_SIGNER_FILE names a separate private file.
# launch.mjs rejects CONC_LIQ_*, PATH, ANVIL_BIN and other reserved launcher names.

# PostgreSQL for the deployment command database. It must already be at schema v14:
# the worker never runs DDL and refuses to start otherwise.
DATABASE_URL=

# Read endpoint (archive-capable, historical reads, wallet-scoped Transfer log queries).
ROBINHOOD_READ_HTTP_URL=
# Optional owned-fork source for simulations; defaults to ROBINHOOD_READ_HTTP_URL.
# PAPER_FORK_RPC_URL=
# Per-request RPC timeout in ms (1000-30000, default 12000).
# DEPLOYMENT_RPC_TIMEOUT_MS=

# The single configured server wallet (public address). Must match the command service.
DEPLOYMENT_OPERATOR_WALLET_ADDRESS=

# 0 (default) = observe-only: keeps wallet history and the canonical wallet snapshot
# fresh; takes no readiness lease and loads no signer or publisher.
# 1 = signer + publisher + queue steps + readiness lease (the only supervised process
# that proves the worker is connected to the command service).
DEPLOYMENT_LIVE_EXECUTION=0
# 0 (default) | 1. Automatic recenter/retain observation and enqueue. Runs inside the
# execution step, so it requires DEPLOYMENT_LIVE_EXECUTION=1.
DEPLOYMENT_LIVE_MANAGEMENT=0

# Required only when DEPLOYMENT_LIVE_EXECUTION=1.
# Independent authenticated publisher endpoint (eth_sendRawTransaction only).
RH_BROADCAST_RPC_URL=
# Absolute path to a regular, non-symlink file with mode 0600 (no group/other access)
# holding the key as KEY=0x<64 hex>; its derived address must equal the wallet above.
DEPLOYMENT_LIVE_SIGNER_FILE=
# Variable name inside that file (default WALLET_PRIVATE_KEY).
# DEPLOYMENT_LIVE_SIGNER_VARIABLE=WALLET_PRIVATE_KEY

# Loop cadence in ms (5000-60000, default 15000) and queue steps per pass (1-32, default 8).
# DEPLOYMENT_LIVE_WORKER_INTERVAL_MS=15000
# DEPLOYMENT_LIVE_MAX_STEPS_PER_PASS=8

# Wallet-scoped Position Manager history maintenance. The first genesis backfill is an
# explicit operator step (nft-wallet-index); this loop only extends an existing cursor.
# Cadence once complete (5000-300000 ms, default 30000).
# DEPLOYMENT_LIVE_HISTORY_INTERVAL_MS=30000
# Per getLogs chunk (1-10000000, default 100000) and scan budget per pass (1-100000000,
# default 1000000; the chunk may not exceed it).
# DEPLOYMENT_LIVE_HISTORY_CHUNK_BLOCKS=100000
# DEPLOYMENT_LIVE_HISTORY_MAX_BLOCKS_PER_PASS=1000000

# Refresh the persisted canonical wallet snapshot once its source is this old (0-150 s,
# default 120; 0 = every pass). Dashboard readiness requires <= 180 s. Every refresh
# starts a new wallet generation and source, and admission rejects a frozen setup review
# whose generation/source moved, so a lower value shortens the approve window after a
# preflight (a preflight itself refreshes the snapshot, which restarts this clock).
# DEPLOYMENT_LIVE_SNAPSHOT_REFRESH_AFTER_SECONDS=120

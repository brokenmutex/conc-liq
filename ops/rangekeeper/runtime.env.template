# Install as /etc/conc-liq/rangekeeper-runtime.env with mode 0600.
# Use a private archive endpoint with historical reads and an independent
# authenticated publisher endpoint. Do not put the signing key in this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
RH_ARCHIVE_RPC_URL=https://ARCHIVE_RPC
RH_BROADCAST_RPC_URL=https://PUBLISHER_RPC

# The public endpoint is fine for a smoke test. Use a dedicated provider for
# reliable indexing and unattended operation.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The first research universe from the architecture plan.
RWA_SYMBOLS=GLD,SPY,QQQ,NVDA,AAPL,GOOGL,MSFT
UNISWAP_V3_FEE_TIERS=100,500,3000,10000

ROBINHOOD_ASSETS_URL=https://api.robinhood.com/rhj/assets
# Official issuer policy fetched and hashed on every risk snapshot.
ROBINHOOD_MARKET_POLICY_URL=https://robinhood.com/rhj/stocktokens/
# Fetched on every risk snapshot; feed addresses are not copied into config.
CHAINLINK_ROBINHOOD_FEEDS_URL=https://reference-data-directory.vercel.app/feeds-robinhood-mainnet.json
HTTP_TIMEOUT_MS=10000
RPC_TIMEOUT_MS=15000
RISK_MAX_PRICE_AGE_SECONDS=300
RISK_SNAPSHOT_INTERVAL_MS=60000
RISK_GATE_MAX_SNAPSHOT_AGE_SECONDS=180
RISK_GATE_MAX_CANONICALITY_AGE_SECONDS=30

# Historical/indexer reads can use a private or archive node independently of
# the one-shot observer. Never commit its endpoint or credentials.
# RH_INDEXER_RPC_URL=http://private-read-node:8547
INDEXER_CONFIRMATION_DEPTH=64
INDEXER_INITIAL_CHUNK_SIZE=10000
INDEXER_MIN_CHUNK_SIZE=100
INDEXER_MAX_CHUNK_SIZE=25000
INDEXER_REORG_OVERLAP=256
INDEXER_POOLS_PATH=config/indexer-pools.json
INDEXER_STREAM_KEY=robinhood-v3-rwa-usdg-v1

# Bounded parallelism for the on-demand, block-pinned fee-accounting snapshot.
ACCOUNTING_CONCURRENCY=24

# Optional comma-separated Uniswap V3 Position Manager token IDs. The hourly
# accounting service skips this step safely while the list is empty.
NFT_POSITION_TOKEN_IDS=

# Without DATABASE_URL, observations are appended to this ignored JSONL file.
SNAPSHOT_JSONL_PATH=data/snapshots.jsonl

# Optional PostgreSQL persistence.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conc_liq

# Read-only operator dashboard. Remote binding is deliberately rejected; use
# an SSH tunnel to reach this listener from another machine.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4173
DASHBOARD_REFRESH_MS=10000
DASHBOARD_ACTIVITY_WINDOW_BLOCKS=20000
DASHBOARD_ACTIVITY_BUCKET_BLOCKS=500

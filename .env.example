# The public endpoint is fine for a smoke test. Use a dedicated provider for
# reliable indexing and unattended operation.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The first research universe from the architecture plan.
RWA_SYMBOLS=GLD,SPY,QQQ,NVDA,AAPL,GOOGL,MSFT
UNISWAP_V3_FEE_TIERS=100,500,3000,10000

ROBINHOOD_ASSETS_URL=https://api.robinhood.com/rhj/assets
HTTP_TIMEOUT_MS=10000
RPC_TIMEOUT_MS=15000

# Without DATABASE_URL, observations are appended to this ignored JSONL file.
SNAPSHOT_JSONL_PATH=data/snapshots.jsonl

# Optional PostgreSQL persistence.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conc_liq

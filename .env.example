# The public endpoint is fine for a smoke test. Use a dedicated provider for
# reliable indexing and unattended operation.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The first research universe from the architecture plan.
RWA_SYMBOLS=GLD,SPY,QQQ,NVDA,AAPL,GOOGL,MSFT
UNISWAP_V3_FEE_TIERS=100,500,3000,10000

ROBINHOOD_ASSETS_URL=https://api.robinhood.com/rhj/assets
# Official issuer policy fetched and hashed on every risk snapshot.
ROBINHOOD_MARKET_POLICY_URL=https://robinhood.com/rhj/stocktokens/
# Fetched on every risk snapshot; feed addresses are not copied into config.
CHAINLINK_ROBINHOOD_FEEDS_URL=https://reference-data-directory.vercel.app/feeds-robinhood-mainnet.json
HTTP_TIMEOUT_MS=10000
RPC_TIMEOUT_MS=15000
RISK_MAX_PRICE_AGE_SECONDS=300
RISK_SNAPSHOT_INTERVAL_MS=60000
RISK_GATE_MAX_SNAPSHOT_AGE_SECONDS=180
RISK_GATE_MAX_CANONICALITY_AGE_SECONDS=30

# Maximum age of the synchronized NVDA pool/risk checkpoint used by the
# signer-free canary planner. All sizing/range/risk choices remain CLI-required.
CANARY_MAX_CHECKPOINT_AGE_SECONDS=180

# Live validation/risk node. Historical routing below takes precedence in
# research commands; this node still supplies near-head state and hash checks.
# RH_INDEXER_RPC_URL=http://private-read-node:8547
# Native HyperSync is preferred; envio selects the separate HyperRPC product.
# legacy preserves the original single-RPC setup.
HISTORY_SOURCE=legacy
# ENVIO_API_TOKEN=your-token
# HYPERSYNC_URL=https://4663.hypersync.xyz
# Optional full HyperRPC endpoint instead of building it from the token.
# RH_HISTORY_RPC_URL=https://4663.rpc.hypersync.xyz/your-token
# REQUIRED for historical eth_call/code/balance/storage in either isolated mode.
# No fallback to the private node; absent archive state is explicitly unavailable.
# RH_ARCHIVE_RPC_URL=https://independent-archive-provider.example/rpc
# Minimum spacing per provider URL within each process. HyperRPC has bounded
# 429 retries; native errors stop the request and surface to the caller.
HISTORY_REQUEST_INTERVAL_MS=500
# Includes provider pacing/queuing; does not change the live node timeout.
HISTORY_RPC_TIMEOUT_MS=60000
INDEXER_CONFIRMATION_DEPTH=64
INDEXER_INITIAL_CHUNK_SIZE=10000
INDEXER_MIN_CHUNK_SIZE=100
INDEXER_MAX_CHUNK_SIZE=25000
INDEXER_REORG_OVERLAP=256
INDEXER_POOLS_PATH=config/indexer-pools.json
INDEXER_STREAM_KEY=robinhood-v3-rwa-usdg-v1

# Fail-closed private-node circuit. References must be operationally independent
# of the private node; only their names and public URLs are persisted.
RPC_HEALTH_REFERENCE_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-mainnet-rpc.blockreq.com/v1/rpc/public
RPC_HEALTH_REFERENCE_QUORUM=2
RPC_HEALTH_CONFIRMATION_DEPTH=64
RPC_HEALTH_SOFT_LAG_BLOCKS=20
RPC_HEALTH_HARD_LAG_BLOCKS=100
RPC_HEALTH_SOFT_LAG_SECONDS=5
RPC_HEALTH_HARD_LAG_SECONDS=30
RPC_HEALTH_SOFT_LATENCY_MS=2000
RPC_HEALTH_HARD_LATENCY_MS=5000
RPC_HEALTH_STALL_SECONDS=30
RPC_HEALTH_RECOVERY_SAMPLES=12
RPC_HEALTH_POLL_INTERVAL_MS=10000
RPC_HEALTH_REQUEST_TIMEOUT_MS=5000
RPC_HEALTH_GATE_ENABLED=true
RPC_HEALTH_CACHE_MS=2000
RPC_HEALTH_MAX_SAMPLE_AGE_SECONDS=30

# Bounded parallelism for the on-demand, block-pinned fee-accounting snapshot.
ACCOUNTING_CONCURRENCY=4

# Bounded receipt batches for confirmation-safe action-cost observations.
ACTION_COST_CONCURRENCY=4

# Block-pinned ETH/USD and USDG/USD valuation of observed native gas fees.
# Kept sequential and paced because every mark reads two oracle contracts.
ACTION_COST_VALUATION_CONCURRENCY=1
ACTION_COST_VALUATION_DELAY_MS=250
# Historical accounting uses the feed heartbeat, capped at one day. This is
# deliberately separate from the much tighter live execution-risk ceiling.
ACTION_COST_VALUATION_MAX_PRICE_AGE_SECONDS=86400

# Guarded scan of direct token approvals to the canonical Position Manager.
APPROVAL_COST_INITIAL_CHUNK_SIZE=5000
APPROVAL_COST_MIN_CHUNK_SIZE=100
APPROVAL_COST_DELAY_MS=250

# Block-pinned valuation of comparable approval observations only.
APPROVAL_COST_VALUATION_DELAY_MS=250
APPROVAL_COST_VALUATION_MAX_PRICE_AGE_SECONDS=86400

# Shadow-only trade[XYZ] HIP-3 reference. This source is fetched directly and
# never authorizes execution; thresholds only classify research data quality.
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
PERP_REFERENCE_DEX=xyz
PERP_REFERENCE_COIN=xyz:NVDA
PERP_REFERENCE_REQUEST_TIMEOUT_MS=10000
PERP_REFERENCE_MAX_MARK_ORACLE_DEVIATION_PPM=5000
PERP_REFERENCE_MAX_MID_ORACLE_DEVIATION_PPM=10000
PERP_REFERENCE_MAX_IMPACT_SPREAD_PPM=10000
PERP_REFERENCE_MIN_DAY_NOTIONAL_USD=1000000
PERP_REFERENCE_MIN_OPEN_INTEREST_NOTIONAL_USD=5000000

# Shadow-only pool basis join. The USDG quote is never accepted beyond the
# lower of its published heartbeat and the configured maximum.
PERP_BASIS_MAX_SOURCE_AGE_SECONDS=600
PERP_BASIS_MAX_SOURCE_SKEW_SECONDS=360
PERP_BASIS_MAX_QUOTE_ORACLE_AGE_SECONDS=86400
PERP_BASIS_MAX_QUOTE_DEPEG_PPM=10000
PERP_BASIS_MAX_POOL_DEVIATION_PPM=20000

# Optional comma-separated Uniswap V3 Position Manager token IDs. The hourly
# accounting service skips this step safely while the list is empty.
NFT_POSITION_TOKEN_IDS=

# Without DATABASE_URL, observations are appended to this ignored JSONL file.
SNAPSHOT_JSONL_PATH=data/snapshots.jsonl

# Optional PostgreSQL persistence.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conc_liq

# Read-only operator dashboard. Remote binding is deliberately rejected; use
# an SSH tunnel to reach this listener from another machine.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4173
DASHBOARD_REFRESH_MS=10000
DASHBOARD_ACTIVITY_WINDOW_BLOCKS=20000
DASHBOARD_ACTIVITY_BUCKET_BLOCKS=500
